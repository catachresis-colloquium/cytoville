module Abi.Generate
import Abi.Types
import System.File
import System
%default total

writeChecked : String -> String -> IO ()
writeChecked path body = do
  Right () <- writeFile path body | Left err => die (show err)
  pure ()

main : IO ()
main = do
  writeChecked "src/interface/generated/layout.zig" ("// SPDX-License-Identifier: AGPL-3.0-or-later\n// Generated by Abi.Generate.\npub const abi_version: u32 = " ++ show abiVersion ++ ";\npub const observation_size: usize = " ++ show observationSize ++ ";\npub const memory_size: usize = " ++ show memorySize ++ ";\npub const intent_size: usize = " ++ show intentSize ++ ";\n")
  writeChecked "src/interface/generated/layout.rs" ("// SPDX-License-Identifier: AGPL-3.0-or-later\n// Generated by Abi.Generate.\npub const ABI_VERSION: u32 = " ++ show abiVersion ++ ";\npub const OBSERVATION_SIZE: usize = " ++ show observationSize ++ ";\npub const MEMORY_SIZE: usize = " ++ show memorySize ++ ";\npub const INTENT_SIZE: usize = " ++ show intentSize ++ ";\n")

  writeChecked "src/interface/generated/offsets.rs" ("// SPDX-License-Identifier: AGPL-3.0-or-later\n// Generated by Abi.Generate.\npub const HEALTH_OFFSET: usize = " ++ show healthOffset ++ ";\npub const CONTACT_OFFSET: usize = " ++ show contactOffset ++ ";\npub const ACTION_OFFSET: usize = " ++ show actionOffset ++ ";\npub const TARGET_OFFSET: usize = " ++ show targetOffset ++ ";\n")
  writeChecked "src/interface/generated/offsets.zig" ("// SPDX-License-Identifier: AGPL-3.0-or-later\n// Generated by Abi.Generate.\npub const health_offset: usize = " ++ show healthOffset ++ ";\npub const contact_offset: usize = " ++ show contactOffset ++ ";\npub const action_offset: usize = " ++ show actionOffset ++ ";\npub const target_offset: usize = " ++ show targetOffset ++ ";\n")
  writeChecked "src/interface/generated/layout.h" ("/* SPDX-License-Identifier: AGPL-3.0-or-later */\n/* Generated by Abi.Generate. */\n#define CYTOVILLE_ABI_VERSION " ++ show abiVersion ++ "\n#define CYTOVILLE_OBSERVATION_SIZE " ++ show observationSize ++ "\n#define CYTOVILLE_MEMORY_SIZE " ++ show memorySize ++ "\n#define CYTOVILLE_INTENT_SIZE " ++ show intentSize ++ "\n#define CYTOVILLE_HEALTH_OFFSET " ++ show healthOffset ++ "\n#define CYTOVILLE_CONTACT_OFFSET " ++ show contactOffset ++ "\n#define CYTOVILLE_ACTION_OFFSET " ++ show actionOffset ++ "\n#define CYTOVILLE_TARGET_OFFSET " ++ show targetOffset ++ "\n")
